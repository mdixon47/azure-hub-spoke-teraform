# Copy this file to terraform.tfvars and fill in the sensitive values.
# DO NOT commit terraform.tfvars to source control.

prefix   = "hubspk"
location = "eastus"

# Credentials -----------------------------------------------------------------
vm_admin_username = "azureuser"
# Provide either a password OR an SSH public key. SSH key takes precedence.
# vm_admin_password       = "REPLACE_WITH_STRONG_PASSWORD!"
vm_admin_ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2E... user@host"

sql_admin_username = "sqladminuser"
sql_admin_password = "REPLACE_WITH_STRONG_PASSWORD!"

# Networking ------------------------------------------------------------------
hub_vnet_cidr   = "10.0.0.0/16"
spoke_vnet_cidr = "10.1.0.0/16"

# Compute sizing --------------------------------------------------------------
web_vm_size = "Standard_B2s"
app_vm_size = "Standard_B2s"

# Observability & lifecycle ---------------------------------------------------
log_retention_days    = 30
enable_resource_locks = false

# HTTPS / Key Vault -----------------------------------------------------------
# When enable_https = true (the default), the security module deploys a Key
# Vault with the firewall locked down. To bootstrap from a local CLI or a
# hosted CI runner, Terraform needs data-plane access to the vault during
# apply, which requires either a private endpoint (production) or a temporary
# allow-list opening (dev/bootstrap).
enable_https                     = true
kv_public_network_access_enabled = true
# Replace with your egress IPv4: curl -4 -fsS ifconfig.me
kv_allowed_ip_ranges = ["198.51.100.10/32"]
appgw_cert_subject   = "CN=appgw.example.com"
appgw_cert_dns_names = ["appgw.example.com"]

tags = {
  environment = "dev"
  project     = "hub-spoke-reference"
  managed_by  = "terraform"
  owner       = "platform-team"
}
